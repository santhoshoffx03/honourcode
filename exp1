
clc;
clear;
close all;

% Read sensor data from CSV file
data = readmatrix('SensorData.csv');

LDR = data(:,1);
POT = data(:,2);

Samples = 1:length(LDR);

% Plot sensor readings
figure;
plot(Samples, LDR, 'b', 'LineWidth', 2);
hold on;
plot(Samples, POT, 'r', 'LineWidth', 2);
grid on;
xlabel('Sample Number');
ylabel('Sensor Value');
title('Sensor Readings');
legend('LDR', 'Potentiometer');

% IoT protocol parameters
Protocols = {'Bluetooth', 'ZigBee', 'LoRa'};
Range = [10 100 15000];
DataRate = [2 0.25 0.05];
Power = [100 40 25];
Latency = [10 35 300];
PDR = [98 98 96];

disp('-----------------------------------------------');
disp('         IoT Protocol Simulation');
disp('-----------------------------------------------');

for i = 1:length(Protocols)
    fprintf('\nProtocol: %s\n', Protocols{i});
    fprintf('Range: %.2f m\n', Range(i));
    fprintf('Data Rate: %.2f Mbps\n', DataRate(i));
    fprintf('Power Consumption: %.2f mW\n', Power(i));
    fprintf('Latency: %.2f ms\n', Latency(i));
    fprintf('Packet Delivery: %.2f %%\n', PDR(i));
end

% Communication range
figure;
bar(Range);
grid on;
title('Communication Range');
ylabel('Range (m)');
set(gca, 'XTick', 1:3, 'XTickLabel', Protocols);

% Data rate
figure;
bar(DataRate);
grid on;
title('Data Rate');
ylabel('Mbps');
set(gca, 'XTick', 1:3, 'XTickLabel', Protocols);

% Power consumption
figure;
bar(Power);
grid on;
title('Power Consumption');
ylabel('Power (mW)');
set(gca, 'XTick', 1:3, 'XTickLabel', Protocols);

% Latency
figure;
bar(Latency);
grid on;
title('Latency');
ylabel('Milliseconds');
set(gca, 'XTick', 1:3, 'XTickLabel', Protocols);

% Packet delivery ratio
figure;
bar(PDR);
grid on;
title('Packet Delivery Ratio');
ylabel('PDR (%)');
ylim([90 100]);
set(gca, 'XTick', 1:3, 'XTickLabel', Protocols);

% Packet transmission simulation
disp(' ');
disp('-----------------------------------------');
disp('       Packet Transmission');
disp('-----------------------------------------');

for i = 1:length(LDR)
    fprintf('\nPacket %d\n', i);
    fprintf('LDR Value: %.0f\n', LDR(i));
    fprintf('Potentiometer Value: %.0f\n', POT(i));

    fprintf('Bluetooth: Packet Sent Successfully\n');
    pause(0.1);

    fprintf('ZigBee: Packet Sent Successfully\n');
    pause(0.1);

    fprintf('LoRa: Packet Sent Successfully\n');
    pause(0.1);
end
