
clc;
clear;
close all;

%% Initialize Parameters
N = 50;

pot = zeros(1,N);
RSSI = zeros(1,N);
zone = zeros(1,N);

%% Simulate Device Localization
for i = 1:N

    pot(i) = randi([0 1023]);

    RSSI(i) = -40 - (pot(i)/1023)*50;

    if RSSI(i) >= -50
        zone(i) = 1;
        location = 'Zone 1 - Very Near';

    elseif RSSI(i) >= -60
        zone(i) = 2;
        location = 'Zone 2 - Near';

    elseif RSSI(i) >= -70
        zone(i) = 3;
        location = 'Zone 3 - Medium';

    elseif RSSI(i) >= -80
        zone(i) = 4;
        location = 'Zone 4 - Far';

    else
        zone(i) = 5;
        location = 'Zone 5 - Very Far';
    end

    fprintf(['Sample %2d | Potentiometer = %4d | ' ...
        'RSSI = %6.2f dBm | %s\n'], ...
        i,pot(i),RSSI(i),location);

    pause(0.2);
end

%% Graph 1: Potentiometer Data
figure;
plot(pot,'o-','LineWidth',1.5);
grid on;
xlabel('Sample Number');
ylabel('Potentiometer Value');
title('Simulated Potentiometer Sensor Data');

%% Graph 2: BLE Signal Strength
figure;
plot(RSSI,'o-','LineWidth',1.5);
hold on;

plot([1 N],[-50 -50],'--');
plot([1 N],[-60 -60],'--');
plot([1 N],[-70 -70],'--');
plot([1 N],[-80 -80],'--');

grid on;
xlabel('Sample Number');
ylabel('RSSI (dBm)');
title('Simulated BLE Signal Strength');

legend('RSSI','-50 dBm','-60 dBm', ...
    '-70 dBm','-80 dBm');

%% Graph 3: Localization Zones
figure;
stairs(zone,'LineWidth',2);
grid on;
xlabel('Sample Number');
ylabel('Localization Zone');
title('IoT Device Localization Based on BLE RSSI');

set(gca,'YTick',1:5);
set(gca,'YTickLabel', ...
    {'Very Near','Near','Medium','Far','Very Far'});

ylim([0.5 5.5]);

%% Display Summary
fprintf('\n====================================\n');
fprintf('IoT DEVICE LOCALIZATION SUMMARY\n');
fprintf('====================================\n');

for i = 1:5
    fprintf('Zone %d samples: %d\n',i,sum(zone==i));
end

disp('Localization Simulation Completed Successfully');
